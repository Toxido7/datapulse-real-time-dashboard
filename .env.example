# OpenWeather configuration for the Weather module
VITE_WEATHER_API_KEY=your_openweather_api_key
VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5
VITE_WEATHER_CURRENT_PATH=/weather
VITE_WEATHER_FORECAST_PATH=/forecast

# CoinGecko and REST Countries use public endpoints in this project,
# so no additional environment variables are required for Markets or Countries.
